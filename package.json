{
  "name": "razer-macos",
  "version": "0.6.0",
  "description": "Open source color effects manager for Razer peripherals on macOS",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uefigs139/razer-macos.git"
  },
  "license": "GPL-2.0-only",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "rm -rf out && electron-vite build",
    "test": "vitest run",
    "dist": "yarn build && electron-builder",
    "dist:dir": "yarn dist --dir -c.compression=store -c.mac.identity=null",
    "rebuild": "node-gyp rebuild",
    "clean": "node-gyp clean",
    "prettier:js": "prettier --write \"src/main/**/*.js\""
  },
  "dependencies": {
    "electron-json-storage": "^4.6.0",
    "node-addon-api": "^8.9.2",
    "tinycolor2": "^1.6.0",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "node-gyp": "^11.4.2",
    "prettier": "^3.6.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "resolutions": {
    "vite": "^8.2.2"
  },
  "gypfile": true,
  "build": {
    "appId": "com.electron.razer-macos",
    "productName": "Razer macOS",
    "nodeGypRebuild": true,
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "xhi-nico",
        "repo": "razer-macos"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "icon.icns",
      "type": "distribution",
      "hardenedRuntime": false,
      "identity": "-",
      "sign": "./scripts/sign.js",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "x64ArchFiles": "**/node_modules/uiohook-napi/prebuilds/**",
      "extendInfo": {
        "NSCalendarsFullAccessUsageDescription": "Auto lights counts down to your next meeting on the keyboard.",
        "NSCalendarsUsageDescription": "Auto lights counts down to your next meeting on the keyboard.",
        "NSMicrophoneUsageDescription": "Auto lights shows how loud you are on a call on the keyboard. Only loudness is measured; nothing is recorded.",
        "NSAudioCaptureUsageDescription": "Auto lights shows how loud the other side of a call is on the keyboard. Only loudness is measured; nothing is recorded."
      }
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node"
    ]
  }
}
